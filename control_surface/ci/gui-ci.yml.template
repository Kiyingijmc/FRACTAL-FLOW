name: Control Surface GUI CI

on:
  push:
    paths:
      - 'control_surface/**'
      - '.github/workflows/gui-ci.yml'
  pull_request:
    paths:
      - 'control_surface/**'
      - '.github/workflows/gui-ci.yml'

jobs:
  build-and-lint:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: control_surface
    steps:
      - uses: actions/checkout@v4
      - name: Use Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: 'control_surface/package.json'
      - name: Install dependencies
        run: npm install
      - name: TypeScript Lint Check
        run: npm run lint
      - name: Build Production Assets
        run: npm run build
