name: Control Surface GUI CI

on:
  push:
    paths:
      - 'control_surface/**'
      - '.github/workflows/gui-ci.yml'
  pull_request:
    paths:
      - 'control_surface/**'
      - '.github/workflows/gui-ci.yml'

permissions:
  contents: read

jobs:
  build-and-test:
    name: Build, Lint & Test Control Surface
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: control_surface
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Use Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: 'control_surface/package-lock.json'

      - name: Install reproducible dependencies
        run: npm ci

      - name: TypeScript Lint Check
        run: npm run lint

      - name: Automated Invariant & Behavioral Test Suite
        run: npm test

      - name: Build Production Assets
        run: npm run build
