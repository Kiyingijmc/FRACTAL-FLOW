+              limitValue: riskConfig.maxAccountExposureR,
+            },
+          ],
+        };
+      }
+
+      // Check if current portfolio risk already equals or exceeds maxAccountExposureR
+      if (portEval.totalRiskR !== null && portEval.totalRiskR >= riskConfig.maxAccountExposureR) {
+        return {
