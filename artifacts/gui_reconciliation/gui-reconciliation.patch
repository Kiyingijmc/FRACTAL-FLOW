From 0d77b382f0699c37828afdb725408ca73f7526cb Mon Sep 17 00:00:00 2001
From: Kiyingijmc <108143103+Kiyingijmc@users.noreply.github.com>
Date: Thu, 29 Oct 2026 04:49:42 +0000
Subject: [PATCH] fix(test): make H1.1.2-SEAM-01 self-sufficient by building
 production assets if dist is absent

---
 .../src/tests/stage_h1_1_production_path.test.ts          | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/control_surface/src/tests/stage_h1_1_production_path.test.ts b/control_surface/src/tests/stage_h1_1_production_path.test.ts
index 36c7cac..882260f 100644
--- a/control_surface/src/tests/stage_h1_1_production_path.test.ts
+++ b/control_surface/src/tests/stage_h1_1_production_path.test.ts
@@ -1050,6 +1050,14 @@ async function runStageH11ProductionPathSuite() {
     const path = await import('path');
     const distAssetsDir = path.resolve(process.cwd(), 'dist/assets');
 
+    if (!fs.existsSync(distAssetsDir)) {
+      const { execSync } = await import('child_process');
+      execSync('npx vite build', {
+        env: { ...process.env, NODE_ENV: 'production' },
+        stdio: 'pipe',
+      });
+    }
+
     expect(fs.existsSync(distAssetsDir), 'dist/assets directory must exist from production build');
     const files = fs.readdirSync(distAssetsDir).filter((f: string) => f.endsWith('.js'));
     expect(files.length > 0, 'Production JS bundle must exist');
-- 
